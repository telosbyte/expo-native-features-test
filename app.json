{
  "expo": {
    "name": "Native Features Test App",
    "slug": "native-features-test",
    "version": "1.0.0",
    "description": "Comprehensive test app demonstrating React Native + Expo native features including camera, file handling, GPS, and barcode scanning",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nativefeatures",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#007AFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nativefeatures.testapp",
      "infoPlist": {
        "NSCameraUsageDescription": "This app requires camera access to take photos and scan barcodes",
        "NSPhotoLibraryUsageDescription": "This app requires photo library access to save and select images",
        "NSLocationWhenInUseUsageDescription": "This app requires location access to track GPS coordinates"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#007AFF"
      },
      "package": "com.nativefeatures.testapp",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "This app requires camera access to take photos and scan barcodes"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "This app requires location access to track GPS coordinates"
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b296e5cd-bb84-4b3d-a43f-e36396edb20c"
      }
    }
  }
}
